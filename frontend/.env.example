# Set to true to use bundled mock data (src/mocks/) instead of calling the
# real backend — no backend/Postgres needed for local frontend work.
NEXT_PUBLIC_USE_MOCK=true

# The backend's own URL — frontend and backend are separate deployments,
# so this must be an absolute URL, never a relative path. Production is
# https://engsoc-dashboard-server.vercel.app; for local dev, point at
# wherever you're running the backend (see backend/.env.example, PORT
# defaults to 5001 there).
NEXT_PUBLIC_API_URL=http://localhost:5001
