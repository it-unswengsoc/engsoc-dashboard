# Server
# Frontend owns port 3000 (Next.js default) — this runs as its own
# standalone service now, not routed through the frontend's domain.
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://user:password@localhost:5432/engsoc_dashboard

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth — used for login, Calendar, and Drive access (one consent
# screen, scopes defined in src/functions/google.ts). Sign-in is restricted
# to @unswengsoc.com Google Workspace accounts (see ALLOWED_GOOGLE_DOMAIN in
# src/functions/google.ts) — anyone else is rejected after the consent
# screen, redirected back with ?error=domain_not_allowed.
# Create credentials at https://console.cloud.google.com/apis/credentials
#
# GOOGLE_REDIRECT_URI must exactly match an "Authorized redirect URI" on
# that OAuth client. Production is already registered in Google Cloud as:
#   https://engsoc-dashboard-server.vercel.app/auth/google/callback
# For local dev, register an additional redirect URI pointing at wherever
# the backend actually runs locally, e.g.:
#   http://localhost:5001/auth/google/callback
# and set GOOGLE_REDIRECT_URI to match.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://engsoc-dashboard-server.vercel.app/auth/google/callback

# Calendar rides on the OAuth client above via scopes — no separate key
# needed. Only set this if we later add unauthenticated/public Calendar
# reads that don't go through a signed-in user's OAuth token.
GOOGLE_API_KEY=

# Drive — EngSoc's Drive is organised as top-level Shared Drives (IT,
# Marketing, HR, Executive, ...), not one folder with subfolders. The
# documents page only ever shows the Shared Drives allow-listed by name in
# PORT_DIRECTORIES (src/functions/drive.ts) — everything else the connected
# account can see (HR, Executive, Chairperson, ...) is deliberately never
# queried or shown, since this page is visible to every signed-in member.
# Edit that list to change which drives show up; no folder ID needed here.
#
# This connects with its own service-level refresh token rather than each
# user's own OAuth session — one-time setup, done once by whoever
# administers the shared Drive account:
#   1. Visit GET /auth/google?intent=drive-connect (using the
#      @unswengsoc.com account that's a member of the Shared Drives listed
#      in PORT_DIRECTORIES). Without ?intent=drive-connect this just signs
#      you in normally instead of returning the token JSON below.
#   2. The callback response includes a `refreshToken` field. Copy it here.
GOOGLE_DRIVE_REFRESH_TOKEN=

# Calendar — every Postgres event created/edited/deleted through the
# dashboard is mirrored to this Google Calendar (src/functions/calendar-sync.ts),
# reusing GOOGLE_DRIVE_REFRESH_TOKEN above (it already has the calendar
# scope — see GOOGLE_SCOPES in src/functions/google.ts). Postgres stays the
# source of truth for the dashboard itself; the mirror is what lets members
# see EngSoc events on their own personal Google Calendar, by adding this
# calendar to their own account — no per-user OAuth needed.
#
# Leave unset to mirror into the connected service account's own primary
# calendar. Set to a specific calendar's ID (its email-style address, from
# that calendar's Settings > "Integrate calendar" page) to mirror somewhere
# else instead — e.g. a calendar named "EngSoc Events" that the service
# account has been given "Make changes to events" access to.
GOOGLE_CALENDAR_ID=primary
