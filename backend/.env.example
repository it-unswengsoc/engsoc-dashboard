# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://user:password@localhost:5432/engsoc_dashboard

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth — used for login, Calendar, and Drive access (one consent
# screen, scopes defined in src/functions/google.ts).
# Create credentials at https://console.cloud.google.com/apis/credentials
#
# GOOGLE_REDIRECT_URI must exactly match an "Authorized redirect URI" on
# that OAuth client. Production is already registered in Google Cloud as:
#   https://engsoc-dashboard.vercel.app/api/backend/auth/google/callback
# For local dev, register an additional redirect URI pointing at wherever
# the backend actually runs locally, e.g.:
#   http://localhost:3000/api/auth/google/callback
# (no /api/backend prefix locally — that prefix only exists via the Vercel
# service rewrite in production) and set GOOGLE_REDIRECT_URI to match.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://engsoc-dashboard.vercel.app/api/backend/auth/google/callback

# Calendar and Drive ride on the OAuth client above via scopes — no separate
# key needed for those. Only set this if we later add unauthenticated/public
# Calendar reads that don't go through a signed-in user's OAuth token.
GOOGLE_API_KEY=
