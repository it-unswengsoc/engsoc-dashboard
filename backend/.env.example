# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://user:password@localhost:5432/engsoc_dashboard

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth — used for login, Calendar, and Drive access (one consent
# screen, scopes defined in src/functions/google.ts).
# Create credentials at https://console.cloud.google.com/apis/credentials
#
# GOOGLE_REDIRECT_URI must exactly match an "Authorized redirect URI" on
# that OAuth client. Production is already registered in Google Cloud as:
#   https://engsoc-dashboard.vercel.app/api/backend/auth/google/callback
# For local dev, register an additional redirect URI pointing at wherever
# the backend actually runs locally, e.g.:
#   http://localhost:3000/api/auth/google/callback
# (no /api/backend prefix locally — that prefix only exists via the Vercel
# service rewrite in production) and set GOOGLE_REDIRECT_URI to match.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://engsoc-dashboard.vercel.app/api/backend/auth/google/callback

# Calendar rides on the OAuth client above via scopes — no separate key
# needed. Only set this if we later add unauthenticated/public Calendar
# reads that don't go through a signed-in user's OAuth token.
GOOGLE_API_KEY=

# Drive — EngSoc Drive is ONE shared club drive, not a personal drive per
# signed-in user, so it connects with its own service-level refresh token
# rather than each user's own OAuth session (see src/functions/drive.ts).
#
# One-time setup, done once by whoever administers the shared Drive account:
#   1. Visit GET /api/auth/google (using the Google account that owns/has
#      access to the EngSoc Drive folder — not a personal account).
#   2. The callback response includes a `refreshToken` field. Copy it here.
#   3. Copy the target folder's ID (from its Drive URL) into
#      GOOGLE_DRIVE_ROOT_FOLDER_ID — its immediate subfolders become the
#      "Port Directories" on the documents page.
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
