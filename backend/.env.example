# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/engsoc_dashboard

# JWT Configuration
JWT_SECRET=your_secret_jwt_key_change_this_in_production

# For production, make sure to:
# 1. Use a strong JWT_SECRET (at least 32 characters)
# 2. Use a secure database URL with environment-specific credentials
# 3. Set NODE_ENV to 'production'
# 4. Use HTTPS for all connections
